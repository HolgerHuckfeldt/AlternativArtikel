{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "File": {
      "Path": "AlternaticArtikel.log",
      "Append": "True",
      "MinLevel": "Warning", // min level for the file logger
      "FileSizeLimitBytes": 50000, // use to activate rolling file behaviour
      "MaxRollingFiles": 10 // use to specify max number of log files
    }
  },
  "AllowedHosts": "*",
  "AlternativArtikel": {
    "Swagger": true,
    "SwaggerEndpoint": "https://www.pvwelt-connect.de/int/AlternativArtikel/swagger/v1/swagger.json"
  }
}
